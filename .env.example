# Random shared secret required in X-API-Key for admin endpoints.
SWITCHSIGN_API_KEY=replace-with-random-api-key

# Public base URL used to generate client signing links.
SWITCHSIGN_BASE_URL=https://contracts.example.com

# SQLite DB path inside the container.
SWITCHSIGN_DB_PATH=/app/data/switchsign.db

# Google Drive folder where signed PDFs are uploaded.
GOOGLE_DRIVE_FOLDER_ID=replace-with-drive-folder-id

# Service account JSON path inside the container.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/app/data/drive-service-account.json

# Resend API key for outbound emails.
RESEND_API_KEY=replace-with-resend-api-key

# Verified sender identity in Resend.
EMAIL_FROM_ADDRESS=hello@example.com
EMAIL_FROM_NAME=Switch Case Studio

# Owner notification email for signed contracts.
EMAIL_NOTIFY_OWNER=owner@example.com

# Signing link expiry window.
LINK_EXPIRY_DAYS=7

# Reminder email delay for unsigned contracts.
REMINDER_AFTER_DAYS=3

# Application timezone for scheduler/display defaults.
TZ=America/Los_Angeles

# Logging level.
LOG_LEVEL=INFO

# Use branded Switch Case Studio PDF styling. Set false to fall back to clean default PDF layout.
BRAND_STYLE=true
